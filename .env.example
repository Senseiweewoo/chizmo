# ==========================================
# CHIZMO ENVIRONMENT CONFIGURATION
# ==========================================

# App & URLs
NEXT_PUBLIC_APP_NAME="Chizmo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://chizmo_user:chizmo_password@localhost:5432/chizmo_db?schema=public"

# Redis (Caching, Queues, Live Room State)
REDIS_URL="redis://localhost:6379"

# Authentication & Session Secrets
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-secure-random-32-character-session-secret"
JWT_SECRET="replace-with-a-secure-random-32-character-jwt-secret"

# AI Layer (Provider Agnostic: OpenAI, Anthropic, or Google Gemini)
AI_PROVIDER="openai" # options: "openai" | "gemini" | "anthropic" | "mock"
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="..."
ANTHROPIC_API_KEY="..."

# File Storage (S3 / Cloudflare R2 / MinIO compatible)
S3_ENDPOINT=""
S3_BUCKET_NAME="chizmo-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Stripe Payments & Billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
