datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  TEACHER
  ADMIN
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CardType {
  basic
  cloze
  mcq
  true_false
  short_answer
  ordering
  matching
}

enum CreatedBy {
  AI
  USER
}

enum LearnState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum SourceType {
  TOPIC
  TEXT
  PDF
  PPTX
  DOCX
  YOUTUBE
  AUDIO
  IMAGE_OCR
  QUIZLET
  ANKI
  WEB_URL
}

enum SourceStatus {
  PENDING
  EXTRACTING
  GENERATING
  REVIEW
  READY
  FAILED
}

enum RoomStatus {
  LOBBY
  QUESTION
  REVEAL
  LEADERBOARD
  PODIUM
  ENDED
}

model User {
  id              String         @id @default(cuid())
  email           String?        @unique
  passwordHash    String?
  displayName     String
  birthYear       Int?
  isGuest         Boolean        @default(true)
  timezone        String         @default("UTC")
  dayRolloverHour Int            @default(4)
  avatarUrl       String?
  role            Role           @default(USER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile         Profile?
  sessions        Session[]
  subscription    Subscription?
  entitlement     Entitlement?
  decks           Deck[]         @relation("DeckOwner")
  cardStates      CardState[]
  reviewLogs      ReviewLog[]
  studySessions   StudySession[]
  streakDays      StreakDay[]
  achievements    UserAchievement[]
  tutorThreads    TutorThread[]
  summaries       Summary[]
  sources         Source[]
  hostedRooms     LiveRoom[]     @relation("HostRooms")
  notifications   Notification[]
  folders         DeckFolder[]
  importJobs      ImportJob[]

  @@index([email])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  targetExams     String[] @default([])
  studyGoalMins   Int      @default(15)
  soundEnabled    Boolean  @default(true)
  hapticsEnabled  Boolean  @default(true)
  reducedMotion   Boolean  @default(false)
  dyslexiaFont    Boolean  @default(false)
  theme           String   @default("system") // system, light, dark

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([sessionToken])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("FREE") // FREE, PRO, STUDENT
  status               String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id                   String   @id @default(cuid())
  userId               String   @unique
  dailyGenerationsUsed Int      @default(0)
  lastResetDate        DateTime @default(now())
  maxDecks             Int      @default(50)
  maxUploadMb          Int      @default(25) // Free tier: 25MB, Pro: 200MB

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Source {
  id            String       @id @default(cuid())
  userId        String
  type          SourceType
  url           String?
  fileKey       String?
  status        SourceStatus @default(PENDING)
  extractedText String?      @db.Text
  error         String?
  settings      Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  decks         Deck[]
  summaries     Summary[]

  @@index([userId, status])
}

model DeckFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decks     Deck[]
}

model Deck {
  id           String        @id @default(cuid())
  ownerId      String
  title        String
  description  String?       @db.Text
  visibility   Visibility    @default(PRIVATE)
  language     String        @default("en")
  folderId     String?
  forkedFromId String?
  sourceId     String?
  examDate     DateTime?
  tags         String[]      @default([])
  color        String?       @default("#6366F1")
  icon         String?       @default("sparkles")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner        User          @relation("DeckOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folder       DeckFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  cards        Card[]
  studySessions StudySession[]
  liveRooms    LiveRoom[]
  shareLinks   ShareLink[]

  @@index([ownerId])
  @@index([visibility])
  @@index([sourceId])
}

model Card {
  id                 String     @id @default(cuid())
  deckId             String
  type               CardType   @default(basic)
  front              String     @db.Text
  back               String     @db.Text
  choices            Json?      // string[] for MCQ
  correctIndex       Int?
  hint               String?
  explanation        String?    @db.Text
  sourceRef          Json?      // { page, slide, startSec, quote }
  tags               String[]   @default([])
  difficultyEstimate Int?       @default(5)
  position           Int        @default(0)
  createdBy          CreatedBy  @default(AI)
  contentHash        String     @default("")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  deck               Deck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  states             CardState[]
  reviewLogs         ReviewLog[]

  @@index([deckId])
  @@index([contentHash])
}

model CardState {
  userId     String
  cardId     String
  state      LearnState @default(NEW)
  stability  Float      @default(0)
  difficulty Float      @default(5.0)
  due        DateTime   @default(now())
  lastReview DateTime?
  reps       Int        @default(0)
  lapses     Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, due])
  @@index([cardId])
}

model ReviewLog {
  id            String     @id @default(cuid())
  userId        String
  cardId        String
  rating        Int        // 1 Again, 2 Hard, 3 Good, 4 Easy
  prevState     LearnState
  elapsedDays   Float
  scheduledDays Float
  responseMs    Int?
  reviewedAt    DateTime   @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card          Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([cardId])
}

model StudySession {
  id            String    @id @default(cuid())
  userId        String
  deckId        String
  mode          String    // FLASHCARD, QUIZ, WRITE, LEARN, MATCH, TEST, WEAK_SPOTS
  cardsReviewed Int       @default(0)
  correctCount  Int       @default(0)
  xpEarned      Int       @default(0)
  durationMs    Int       @default(0)
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck          Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model Summary {
  id        String   @id @default(cuid())
  userId    String
  sourceId  String?
  title     String
  format    String   // TLDR, BULLETS, CORNELL, OUTLINE, GLOSSARY, ELI12, CHEATSHEET
  content   String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
}

model TutorThread {
  id        String         @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TutorMessage[]
}

model TutorMessage {
  id        String      @id @default(cuid())
  threadId  String
  role      String      // "user" | "assistant" | "system"
  content   String      @db.Text
  sourceRef Json?
  createdAt DateTime    @default(now())

  thread    TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String            @id
  name        String
  description String
  icon        String
  xpReward    Int               @default(50)

  users       UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model StreakDay {
  userId   String
  date     DateTime @db.Date
  xp       Int      @default(0)
  reviews  Int      @default(0)
  isFrozen Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

model LiveRoom {
  id                   String       @id @default(cuid())
  code                 String       @unique // 6-digit code e.g. "CHZ492"
  hostId               String
  deckId               String
  status               RoomStatus   @default(LOBBY)
  settings             Json         @default("{}")
  currentQuestionIndex Int          @default(0)
  questionStartedAt    DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  host                 User         @relation("HostRooms", fields: [hostId], references: [id], onDelete: Cascade)
  deck                 Deck         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  players              LivePlayer[]
  answers              LiveAnswer[]

  @@index([code])
}

model LivePlayer {
  id          String       @id @default(cuid())
  roomId      String
  userId      String?
  nickname    String
  rejoinToken String       @unique
  score       Int          @default(0)
  streak      Int          @default(0)
  connected   Boolean      @default(true)
  createdAt   DateTime     @default(now())

  room        LiveRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  answers     LiveAnswer[]

  @@index([roomId])
}

model LiveAnswer {
  id             String     @id @default(cuid())
  roomId         String
  playerId       String
  questionIndex  Int
  answerIndex    Int
  isCorrect      Boolean
  pointsAwarded  Int        @default(0)
  responseMs     Int?
  answeredAt     DateTime   @default(now())

  room           LiveRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player         LivePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([roomId, questionIndex])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ShareLink {
  id         String    @id @default(cuid())
  deckId     String
  token      String    @unique
  canEdit    Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  deck       Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model Report {
  id         String   @id @default(cuid())
  targetType String   // "deck" | "card" | "user" | "room"
  targetId   String
  reason     String
  reporterId String?
  status     String   @default("PENDING") // PENDING, REVIEWED, DISMISSED
  createdAt  DateTime @default(now())
}

model ImportJob {
  id        String   @id @default(cuid())
  userId    String
  sourceType String  // "QUIZLET" | "ANKI"
  fileKey   String?
  status    String   @default("PENDING")
  totalCards Int     @default(0)
  importedCards Int  @default(0)
  error     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
